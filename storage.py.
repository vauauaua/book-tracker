import json
import os

FILE_NAME = 'books.json'

def load_books():
    if not os.path.exists(FILE_NAME):
        return []
    with open(FILE_NAME, 'r', encoding='utf-8') as f:
        try:
            return json.load(f)
        except json.JSONDecodeError:
            return []

def save_books(books):
    with open(FILE_NAME, 'w', encoding='utf-8') as f:
        json.dump(books, f, ensure_ascii=False, indent=4)

def add_book_to_storage(book_obj):
    books = load_books()
    # Проверка на дубликаты (Важно для Шага 5 задания)
    for b in books:
        if b['title'].lower() == book_obj.title.lower() and b['author'].lower() == book_obj.author.lower():
            print("Ошибка: Такая книга уже есть в списке!")
            return False
    
    books.append(book_obj.to_dict())
    save_books(books)
    return True

def delete_book_from_storage(title):
    books = load_books()
    new_books = [b for b in books if b['title'].lower() != title.lower()]
    if len(books) == len(new_books):
        return False
    save_books(new_books)
    return True
